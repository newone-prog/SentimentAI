    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "mongodb": "^7.3.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.22.2",
    "typescript": "^5.3.3"
  },
  "private": true
