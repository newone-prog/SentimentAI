# ============================================
# SENTIMENTAI - ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================

# AI/LLM API Keys (also needed in dev for Vite proxy passthrough)
VITE_NVIDIA_NIM_KEY=your_nvidia_nim_api_key_here
VITE_OPENROUTER_KEY=your_openrouter_api_key_here

# News API Keys
VITE_GNEWS_API_KEY=your_gnews_api_key_here
VITE_MEDIASTACK_API_KEY=your_mediastack_api_key_here

# Market Data APIs
VITE_MARKETSTACK_API_KEY=your_marketstack_api_key_here
VITE_INDIANAPI_KEY=your_indianapi_key_here

# Firebase Configuration (client-side, safe to expose)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK (server-side only, used by backend/functions)
# Do NOT prefix with VITE_ — these must NEVER be bundled into the client
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"

# Optional: Analytics & Monitoring
VITE_POSTHOG_KEY=your_posthog_analytics_key
VITE_SENTRY_DSN=your_sentry_dsn

# Application Settings
VITE_APP_URL=http://localhost:5173