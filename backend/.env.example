# ============================================
# SENTIMENTAI BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# These keys stay on the SERVER — never exposed to the client
# ============================================

# AI/LLM API Keys (server-side only)
NVIDIA_NIM_KEY=your_nvidia_nim_api_key_here
OPENROUTER_KEY=your_openrouter_api_key_here

# News API Keys
GNEWS_API_KEY=your_gnews_api_key_here
MEDIASTACK_API_KEY=your_mediastack_api_key_here

# Market Data
MARKETSTACK_API_KEY=your_marketstack_api_key_here
INDIANAPI_KEY=your_indianapi_key_here

# Firebase Admin SDK (server-side)
FIREBASE_PROJECT_ID=sentimentai-48241
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@sentimentai-48241.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Application
NODE_ENV=development
PORT=5001
