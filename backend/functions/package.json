{
  "name": "sentimentai-backend",
  "version": "1.0.0",
  "description": "SentimentAI backend API layer - Firebase Functions + Express proxy",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase em:start --only functions",
    "shell": "npm run build && firebase Din shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "cors": "^2.8.5",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "private": true
}
