{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/llm/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|llm).*)",
      "destination": "/index.html"
    }
  ]
}
